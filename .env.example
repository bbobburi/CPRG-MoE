# Published CPRG-MoE image.
CPRG_IMAGE=ghcr.io/bbobburi/cprg-moe:1.0.0

# Physical GPU ID on the execution server.
GPU_ID=0
# Replace with the outputs of: id -u and id -g
LOCAL_UID=1000
LOCAL_GID=1000

# Absolute paths on the execution server. Create OUTPUT_DIR before running.
DATA_DIR=/absolute/path/to/your/data
OUTPUT_DIR=/absolute/path/to/your/results

# File paths relative to DATA_DIR (do not prepend /data).
TRAIN_FILE=train.json
VALID_FILE=valid.json
TEST_FILE=test.json
# Select the supported emotion-label scheme: ConvECPE (6 classes) or RECCON (7 classes).
# A different label scheme requires changes to the code and a new image.
DATASET_TYPE=ConvECPE
DATA_LABEL=my_dataset

# Paper Section 5.2: 20 epochs, batch size 4, learning rate 5e-5.
EPOCHS=20
BATCH_SIZE=4
NUM_WORKER=0
CKPT_NAME=best_model
