# Published CPRG-MoE image.
CPRG_IMAGE=ghcr.io/bbobburi/cprg-moe:1.0.0

# Physical GPU index on your server.
GPU_ID=0

# Replace with the values returned by "id -u" and "id -g".
LOCAL_UID=1000
LOCAL_GID=1000

# Replace with absolute directory paths on your server.
# Create OUTPUT_DIR before running.
DATA_DIR=/absolute/path/to/your/data
OUTPUT_DIR=/absolute/path/to/your/results

# Specify each file's location inside DATA_DIR, not its full server path.
# Example: train.json or split/train.json
TRAIN_FILE=relative/path/to/train.json
VALID_FILE=relative/path/to/valid.json
TEST_FILE=relative/path/to/test.json

# Select the emotion-label scheme supported by your data:
# ConvECPE: 6 classes; RECCON: 7 classes.
# Other emotion-label schemes require code changes and a new image.
DATASET_TYPE=ConvECPE

# Choose a name to identify this run in the logs.
DATA_LABEL=my_experiment

# Training settings from Paper Section 5.2.
EPOCHS=20
BATCH_SIZE=4

# Additional CPU processes for loading data. Keep 0 for the default setup.
NUM_WORKER=0

# Checkpoint filename without the .ckpt extension.
CKPT_NAME=best_model
